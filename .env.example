# Turso (libSQL) Database Configuration
# Leave empty during local development to automatically use local SQLite at ./.superpad-data/superpad.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Secret used to derive deterministic decoy salts for non-existent usernames (prevents username enumeration)
# Generate with: openssl rand -hex 32
AUTH_PEPPER=
